---
export const prerender = true;
import Analytics from '@vercel/analytics/astro'
---
<!DOCTYPE html>
<html class="dark" lang="id">
<head>
    <meta charset="utf-8"/>
    <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
    <title>GanaSatya Dhiracana DCXXV - Portal Perencana</title>
    <!-- Favicon & Icons -->
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml;utf8,&lt;svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 48 48'&gt;&lt;defs&gt;&lt;linearGradient id='bg' x1='0%25' y1='0%25' x2='100%25' y2='100%25'&gt;&lt;stop offset='0%25' stop-color='%23FFD900'/&gt;&lt;stop offset='100%25' stop-color='%23ca8a04'/&gt;&lt;/linearGradient&gt;&lt;/defs&gt;&lt;rect width='48' height='48' rx='12' fill='url(%23bg)'/&gt;&lt;g fill='%23073902' transform='translate(8, 8) scale(0.033333) translate(0, 960)'&gt;&lt;path d='M160-120v-80h640v80H160Zm160-200v-320h80v320h-80Zm160 0v-320h80v320h-80Zm160 0v-320h80v320h-80ZM160-720v-80l320-160 320 160v80H160Zm320-111 204-102-204-102-204 102 204 102Z'/&gt;&lt;/g&gt;&lt;/svg&gt;" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.svg?v=3" />
    <link rel="apple-touch-icon" href="/favicon.svg?v=3" />
    <link rel="mask-icon" href="/favicon.svg?v=3" color="#D19200" />
    <meta name="theme-color" content="#0A0C0A" />
    <script is:inline src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Inter:wght@300;400;500;600&family=JetBrains+Mono:wght@500;600&display=swap" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>

    <!-- Terapkan tema sedini mungkin (hindari flash) -->
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('pp-theme');
          var dark = saved ? saved === 'dark' : true;
          document.documentElement.classList.toggle('dark', dark);
        } catch (e) {}
      })();
    </script>

    <style is:inline>
        /* ================================================================
           DESIGN SYSTEM — Portal Perencana  ·  "MIDNIGHT GOLD"
           ----------------------------------------------------------------
           Dark base netral-hangat yang dalam (bukan hijau-hitam flat) +
           aksen kuning emas #FFD900 sebagai sorotan utama, emas redup utk
           teks sekunder, dan sage hijau sebagai aksen pendukung.
           Gaya: command-center / bento, bersudut tegas, glow terukur.
           Light theme kontras tersedia via toggle. Konten TIDAK diubah.
           ================================================================ */

        :root {
            /* Brand emas + pendukung (dipakai di dua mode) */
            --gold:        #FFD900;
            --gold-soft:   #FFE873;
            --gold-dim:    #C9A227;   /* emas redup utk teks aksen */
            --gold-deep:   #8a6d00;   /* emas pekat utk mode terang */
            --on-gold:     #0A0C0A;
            --sage:        #9fd58c;

            /* ===== LIGHT ===== */
            --bg:            #faf9f4;
            --bg-grid:       rgba(10,12,10,0.04);
            --bg-subtle:     #f1efe6;
            --surface:       #ffffff;
            --surface-2:     #f6f4ec;
            --surface-3:     #efece1;
            --border:        #e4e1d6;
            --border-strong: #d2cdbd;
            --text:          #14160f;
            --text-soft:     #3c4035;
            --text-muted:    #6c7161;
            --text-faint:    #9aa08c;
            --accent:        var(--gold-deep);
            --accent-on:     #ffffff;
            --accent-text:   #7a6000;
            --chip-bg:       #fff6d6;
            --chip-fg:       #7a6000;
            --ring:          rgba(138,109,0,0.3);
            --glow:          0 0 0 rgba(0,0,0,0);
            --shadow-soft:   0 1px 2px rgba(20,22,15,0.05), 0 10px 28px rgba(20,22,15,0.07);
            --shadow-lift:   0 2px 8px rgba(20,22,15,0.07), 0 26px 56px rgba(20,22,15,0.13);

            --radius-sm: 0.5rem;
            --radius-md: 0.75rem;
            --radius-lg: 1rem;
            --radius-xl: 1.5rem;
            --radius-2xl: 2rem;
            --icon-sm: 2.75rem;
            --icon-md: 3.25rem;
        }

        html.dark {
            /* ===== DARK · Midnight Gold ===== */
            --bg:            #0A0C0A;   /* near-black, sedikit hangat */
            --bg-grid:       rgba(255,217,0,0.035);
            --bg-subtle:     #0E110D;
            --surface:       #14180F;   /* kartu */
            --surface-2:     #191E13;   /* elevated */
            --surface-3:     #212717;   /* elevated-2 */
            --border:        rgba(255,255,255,0.07);
            --border-strong: rgba(255,217,0,0.30);
            --text:          #F5F6EF;
            --text-soft:     #C7CDBB;
            --text-muted:    #949C86;
            --text-faint:    #656D59;
            --accent:        #FFD900;
            --accent-on:     #0A0C0A;
            --accent-text:   #FFD900;
            --chip-bg:       rgba(255,217,0,0.11);
            --chip-fg:       #FFE873;
            --ring:          rgba(255,217,0,0.4);
            --glow:          0 0 60px -14px rgba(255,217,0,0.35);
            --shadow-soft:   0 1px 2px rgba(0,0,0,0.5), 0 12px 32px rgba(0,0,0,0.55);
            --shadow-lift:   0 2px 10px rgba(0,0,0,0.55), 0 30px 64px rgba(0,0,0,0.7);
        }

        * { -webkit-font-smoothing: antialiased; }
        html { scroll-behavior: smooth; }
        body {
            font-family: 'Inter', system-ui, -apple-system, sans-serif;
            color: var(--text);
            background-color: var(--bg);
            background-image:
                linear-gradient(var(--bg-grid) 1px, transparent 1px),
                linear-gradient(90deg, var(--bg-grid) 1px, transparent 1px);
            background-size: 56px 56px;
            transition: background-color .4s ease, color .4s ease;
        }
        .font-headline { font-family: 'Manrope', 'Inter', sans-serif; }
        .font-mono { font-family: 'JetBrains Mono', ui-monospace, monospace; }
        .material-symbols-outlined { font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24; }

        .t-text{color:var(--text)} .t-soft{color:var(--text-soft)} .t-muted{color:var(--text-muted)}
        .t-faint{color:var(--text-faint)} .t-accent{color:var(--accent-text)}
        .bg-app{background:var(--bg)} .bg-subtle{background:var(--bg-subtle)}

        section[id] { scroll-margin-top: 6rem; }

        /* Label section: mono + garis emas (identitas command-center) */
        .sec-label {
            display:inline-flex; align-items:center; gap:10px;
            font-family:'JetBrains Mono',monospace; font-size:11px; font-weight:600;
            letter-spacing:0.18em; text-transform:uppercase; color:var(--accent-text);
        }
        .sec-label::before {
            content:''; width:28px; height:2px; background:var(--accent); display:inline-block; border-radius:2px;
        }
        .sec-label.sage { color:var(--sage); }
        .sec-label.sage::before { background:var(--sage); }
        .hl { color: var(--accent-text); }

        /* Ikon container bersudut */
        .ds-icon {
            width:var(--icon-md); height:var(--icon-md); border-radius:var(--radius-md);
            background:var(--chip-bg); color:var(--accent-text);
            display:flex; align-items:center; justify-content:center; flex-shrink:0;
            transition:background .35s ease, color .35s ease, transform .35s ease, box-shadow .35s ease;
        }
        .ds-icon.sm { width:var(--icon-sm); height:var(--icon-sm); }

        /* Kartu dasar bento */
        .bento {
            position:relative; background:var(--surface); border:1px solid var(--border);
            border-radius:var(--radius-xl); overflow:hidden;
            transition:transform .35s cubic-bezier(.4,0,.2,1), border-color .35s, box-shadow .35s, background .35s;
        }
        .bento-hover:hover { transform:translateY(-5px); border-color:var(--border-strong); box-shadow:var(--shadow-lift); }

        /* Kartu aplikasi (bento item) */
        .ds-app-card {
            display:flex; align-items:center; gap:1rem; padding:1.2rem 1.3rem;
            background:var(--surface); border:1px solid var(--border); border-radius:var(--radius-lg);
            text-decoration:none; height:100%; position:relative; overflow:hidden;
            transition:transform .35s cubic-bezier(.4,0,.2,1), background .35s, border-color .35s, box-shadow .35s;
        }
        .ds-app-card::after {
            content:''; position:absolute; inset:0; pointer-events:none; opacity:0;
            background:radial-gradient(120% 120% at 100% 0%, rgba(255,217,0,0.10), transparent 55%);
            transition:opacity .35s;
        }
        .ds-app-card h4 { margin-bottom:2px; color:var(--text); }
        .ds-app-card p  { line-height:1.4; color:var(--text-muted); }
        .ds-app-card:hover { transform:translateY(-5px); border-color:var(--border-strong); box-shadow:var(--shadow-lift); }
        .ds-app-card:hover::after { opacity:1; }
        .ds-app-card:hover .ds-icon { background:var(--accent); color:var(--accent-on); box-shadow:var(--glow); }
        .ds-app-card:focus-visible { outline:2px solid var(--accent); outline-offset:3px; }
        .ds-app-card .ds-arrow { color:var(--text-faint); transition:color .3s, transform .3s; }
        .ds-app-card:hover .ds-arrow { color:var(--accent-text); transform:translate(2px,-2px); }
        .ds-app-card.is-disabled { opacity:.5; cursor:not-allowed; filter:grayscale(.4); }
        .ds-app-card.is-disabled:hover { transform:none; box-shadow:none; border-color:var(--border); }
        .ds-app-card.is-disabled .ds-icon { background:var(--surface-2); color:var(--text-faint); }
        .ds-status-chip {
            display:inline-flex; align-items:center; gap:4px; padding:2px 8px; border-radius:999px;
            background:var(--chip-bg); color:var(--chip-fg);
            font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:0.04em;
        }

        /* Pill eksternal */
        .pp-pill {
            display:inline-flex; align-items:center; justify-content:center; text-align:center;
            padding:0.65rem 1.05rem; border-radius:var(--radius-sm); background:var(--surface-2); border:1px solid var(--border);
            font-size:12px; font-weight:700; color:var(--text-soft); text-decoration:none; transition:all .25s ease;
        }
        .pp-pill:hover { background:var(--accent); color:var(--accent-on); border-color:var(--accent); transform:translateY(-2px); box-shadow:var(--shadow-soft); }

        .pp-note {
            display:flex; align-items:center; gap:0.9rem; padding:1rem 1.1rem;
            border-radius:var(--radius-md); background:var(--surface-2); border:1px solid var(--border);
        }

        /* Navigasi */
        .nav-link {
            font-family:'Manrope',sans-serif; font-size:13px; font-weight:600; letter-spacing:0.01em;
            color:var(--text-soft); transition:color .25s ease; text-decoration:none; position:relative;
        }
        .nav-link:hover { color:var(--accent-text); }
        .nav-link::after {
            content:''; position:absolute; left:0; bottom:-6px; width:0; height:2px; background:var(--accent); transition:width .3s ease;
        }
        .nav-link:hover::after { width:100%; }

        /* Tombol */
        .btn-primary {
            background-color:var(--accent); color:var(--accent-on);
            height:52px; display:inline-flex; align-items:center; justify-content:center;
            padding:0 28px; border-radius:var(--radius-md); font-weight:800; text-decoration:none;
            transition:all .3s cubic-bezier(.4,0,.2,1);
        }
        .btn-primary:hover { transform:translateY(-2px); box-shadow:var(--glow), var(--shadow-lift); filter:brightness(1.04); }
        .btn-secondary {
            background-color:transparent; color:var(--text);
            height:52px; display:inline-flex; align-items:center; justify-content:center;
            padding:0 26px; border-radius:var(--radius-md); font-weight:600; border:1px solid var(--border-strong); text-decoration:none;
            transition:all .3s cubic-bezier(.4,0,.2,1);
        }
        .btn-secondary:hover { border-color:var(--accent); color:var(--accent-text); transform:translateY(-2px); }

        /* HERO gaya lama: panel gradien + glow emas */
        .hero-wrap {
            position:relative; overflow:hidden; border-radius:var(--radius-2xl);
            border:1px solid var(--border);
            background:
                radial-gradient(900px 360px at 50% -8%, rgba(255,217,0,0.14), transparent 60%),
                linear-gradient(160deg, var(--surface-2), var(--surface) 60%, var(--bg));
            box-shadow:var(--shadow-lift);
        }
        .hero-wrap::before {
            content:''; position:absolute; top:-18%; right:-8%; width:380px; height:380px;
            background:radial-gradient(circle, rgba(255,217,0,0.16), transparent 70%); filter:blur(20px);
        }
        .hero-wrap::after {
            content:''; position:absolute; inset:0; opacity:.5; pointer-events:none;
            background-image:url('https://www.transparenttextures.com/patterns/carbon-fibre.png'); mix-blend-mode:overlay;
        }
        html.dark .hero-wrap::after { opacity:.35; }
        html:not(.dark) .hero-wrap::after { opacity:.08; }

        /* Theme toggle */
        .theme-toggle {
            width:40px; height:40px; border-radius:var(--radius-md); display:inline-flex; align-items:center; justify-content:center;
            border:1px solid var(--border); background:var(--surface); color:var(--text-soft); cursor:pointer; transition:all .25s ease;
        }
        .theme-toggle:hover { color:var(--accent-text); border-color:var(--accent); }
        .theme-toggle .icon-moon { display:none; }
        html.dark .theme-toggle .icon-moon { display:inline; }
        html.dark .theme-toggle .icon-sun  { display:none; }

        /* Reveal (dipakai JS: animate-reveal) */
        @keyframes fadeUp { from{opacity:0; transform:translateY(18px);} to{opacity:1; transform:translateY(0);} }
        .animate-reveal { animation:fadeUp .7s cubic-bezier(.22,1,.36,1) both; }
        .stagger-1{animation-delay:.05s} .stagger-2{animation-delay:.12s} .stagger-3{animation-delay:.19s}

        /* Typing cursor (dipakai JS: #typing-text) */
        .typing-cursor::after { content:'|'; animation:blink 1s infinite; margin-left:4px; color:var(--accent); }
        @keyframes blink { 0%,100%{opacity:1} 50%{opacity:0} }

        /* Kalender */
        .calendar-frame-container {
            position:relative; width:100%; height:500px; background:var(--surface-2);
            border-radius:var(--radius-lg); overflow:hidden;
        }

        /* ===== FAQ (markup dirender JS — nama class WAJIB dipertahankan) ===== */
        .faq-pill {
            padding:8px 16px; border-radius:999px; background:var(--surface-2); border:1px solid var(--border);
            color:var(--text-muted); font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:0.06em;
            font-family:'Manrope',sans-serif; cursor:pointer; transition:all .25s ease;
        }
        .faq-pill:hover { color:var(--text); border-color:var(--border-strong); }
        .faq-pill.active { background:var(--accent); color:var(--accent-on); border-color:var(--accent); box-shadow:var(--shadow-soft); }
        .faq-item { background:var(--surface); border:1px solid var(--border); border-radius:var(--radius-md); overflow:hidden; transition:all .3s ease; }
        .faq-item:hover { border-color:var(--border-strong); }
        .faq-item.open { border-color:var(--accent); box-shadow:var(--shadow-soft); }
        .faq-q { width:100%; padding:20px 22px; background:transparent; border:0; color:var(--text); display:flex; align-items:flex-start; justify-content:space-between; gap:16px; cursor:pointer; text-align:left; }
        .faq-q-inner { display:flex; gap:16px; align-items:flex-start; flex:1; }
        .faq-q-badge { flex-shrink:0; width:32px; height:32px; border-radius:9px; background:var(--chip-bg); color:var(--accent-text); display:flex; align-items:center; justify-content:center; font-weight:800; font-size:12px; font-family:'Manrope',sans-serif; transition:all .3s; }
        .faq-item.open .faq-q-badge { background:var(--accent); color:var(--accent-on); }
        .faq-q-cat { display:block; font-size:9px; font-weight:800; text-transform:uppercase; letter-spacing:0.14em; color:var(--accent-text); margin-bottom:4px; font-family:'Manrope',sans-serif; }
        .faq-q-text { font-size:15px; font-weight:600; color:var(--text); line-height:1.4; font-family:'Manrope',sans-serif; }
        .faq-chevron { color:var(--text-faint); transition:transform .35s ease, color .3s; flex-shrink:0; }
        .faq-item.open .faq-chevron { transform:rotate(180deg); color:var(--accent-text); }
        .faq-a { max-height:0; overflow:hidden; transition:max-height .4s ease; }
        .faq-item.open .faq-a { max-height:3000px; }
        .faq-a-inner { padding:0 22px 22px 70px; color:var(--text-soft); font-size:14px; line-height:1.7; border-top:1px solid var(--border); padding-top:18px; margin-top:4px; }
        .faq-a-inner p { margin-bottom:10px; }
        .faq-a-inner ul, .faq-a-inner ol { margin:8px 0 12px 18px; list-style:disc; }
        .faq-a-inner ol { list-style:decimal; }
        .faq-a-inner li { margin-bottom:6px; }
        .faq-a-inner b { color:var(--text); font-weight:700; }
        .faq-a-inner a { color:var(--accent-text); text-decoration:underline; }
        .faq-a-inner table { width:100%; border-collapse:collapse; margin:10px 0; font-size:13px; }
        .faq-a-inner th, .faq-a-inner td { border:1px solid var(--border); padding:8px 10px; text-align:left; }
        .faq-a-inner th { background:var(--surface-2); color:var(--accent-text); font-weight:700; font-size:11px; text-transform:uppercase; letter-spacing:0.05em; }
        .faq-a-inner td:first-child { font-weight:600; color:var(--text); }
        .faq-a-inner .note { margin-top:12px; padding:10px 14px; background:var(--surface-2); border-left:3px solid var(--accent); border-radius:8px; color:var(--text-soft); font-size:13px; }
        .faq-a-inner .note.danger { background:rgba(239,68,68,0.08); border-left-color:#ef4444; color:#e2525f; }
        .faq-a-inner .code { margin-top:10px; padding:10px 14px; background:var(--surface-2); border:1px solid var(--border); border-radius:8px; font-family:ui-monospace,'SFMono-Regular','Menlo',monospace; font-size:12px; color:var(--text-soft); }
        @media (max-width:640px) { .faq-a-inner { padding-left:22px; } .faq-a-inner table { font-size:11px; } .faq-a-inner th, .faq-a-inner td { padding:6px; } }

        /* Panel Gana AI inline (FAQ) */
        .ai-faq-panel { border-radius:var(--radius-xl); background:var(--surface); border:1px solid var(--border); box-shadow:var(--shadow-soft); }
        .ai-quick { padding:8px 14px; border-radius:999px; background:var(--surface-2); border:1px solid var(--border); font-size:12px; font-weight:600; font-family:'Inter',sans-serif; cursor:pointer; transition:all .25s; color:var(--text-soft); }
        .ai-quick:hover { background:var(--accent); color:var(--accent-on); border-color:var(--accent); }
        .ai-faq-input { flex:1; background:var(--surface-2); border:1px solid var(--border); border-radius:999px; padding:12px 18px; font-size:14px; color:var(--text); font-family:'Inter',sans-serif; }
        .ai-faq-input:focus { outline:none; border-color:var(--accent); box-shadow:0 0 0 3px var(--ring); }
        .ai-faq-input::placeholder { color:var(--text-faint); }
        .ai-faq-send { width:44px; height:44px; border-radius:999px; background:var(--accent); color:var(--accent-on); display:flex; align-items:center; justify-content:center; border:0; cursor:pointer; flex-shrink:0; transition:transform .2s; }
        .ai-faq-send:hover { transform:scale(1.05); }

        /* Chatbox */
        .pp-chatbox { background:var(--surface); border:1px solid var(--border); box-shadow:var(--shadow-lift); }
        .pp-chat-head { background:var(--surface-2); border-bottom:1px solid var(--border); }
        .pp-chat-foot { background:var(--surface-2); border-top:1px solid var(--border); }
        .pp-chat-input { flex:1; background:var(--bg); border:1px solid var(--border); border-radius:999px; padding:0.6rem 1rem; font-size:14px; color:var(--text); }
        .pp-chat-input:focus { outline:none; border-color:var(--accent); }
        .pp-chat-input::placeholder { color:var(--text-faint); }
        .pp-bubble-bot { align-self:flex-start; max-width:85%; padding:0.85rem 0.9rem; border-radius:1rem; border-top-left-radius:.35rem; background:var(--surface-2); border:1px solid var(--border); font-size:14px; color:var(--text); line-height:1.6; }

        ::-webkit-scrollbar { width:8px; }
        ::-webkit-scrollbar-track { background:transparent; }
        ::-webkit-scrollbar-thumb { background:var(--border-strong); border-radius:10px; }
        ::-webkit-scrollbar-thumb:hover { background:var(--accent); }

        @media (prefers-reduced-motion: reduce) {
            .animate-reveal, .animate-pulse, .animate-bounce, .typing-cursor::after { animation:none !important; }
            * { transition-duration:.01ms !important; scroll-behavior:auto; }
        }
    </style>

    <script is:inline id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: { extend: { colors: {
                "primary": "#FFD900", "on-primary": "#0A0C0A",
                "surface": "#0A0C0A", "surface-container": "#14180F", "surface-container-high": "#191E13",
                "neon-accent": "#9fd58c", "on-surface": "#F5F6EF", "on-surface-variant": "#949C86",
            } } },
        }
    </script>
</head>
<body class="antialiased overflow-x-hidden">

    <!-- Top Alert Banner -->
    <div class="fixed top-0 left-0 right-0 z-[60]" style="background: linear-gradient(90deg, var(--gold-dim), var(--gold), var(--gold-dim)); color: var(--on-gold);">
