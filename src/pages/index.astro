  function resetFile() {
    selectedFile = null;
    selectedFileType = null;
    selectedFileBase64 = null;
    selectedFileText = null;
    aiFilePreview.classList.add('hidden');
    aiFilePreview.classList.remove('flex');
    aiFileName.textContent = '';
  }

  function fileToBase64(file) {
    return new Promise((resolve) => {
      const reader = new FileReader();
      reader.onload = (e) => resolve(e.target.result);
      reader.readAsDataURL(file);
    });
  }

  async function extractPdfText(file) {
    try {
      if (typeof pdfjsLib === 'undefined') return '[PDF.js belum siap]';
      pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
      const arrayBuffer = await file.arrayBuffer();
      const pdf = await pdfjsLib.getDocument({ data: arrayBuffer }).promise;
      let text = '';
      for (let i = 1; i <= Math.min(pdf.numPages, 10); i++) {
        const page = await pdf.getPage(i);
        const content = await page.getTextContent();
        text += content.items.map(s => s.str).join(' ') + '\n';
      }
      return text.trim() || '[PDF tidak bisa dibaca - mungkin berbentuk scan/gambar]';
    } catch (e) {
      return '[Gagal membaca PDF: ' + e.message + ']';
    }
  }

  async function extractWordText(file) {
    try {
      if (typeof mammoth === 'undefined') return '[Mammoth.js belum siap]';
      const arrayBuffer = await file.arrayBuffer();
      const result = await mammoth.extractRawText({ arrayBuffer });
      return result.value.trim() || '[Dokumen Word kosong atau tidak terbaca]';
    } catch (e) {
      return '[Gagal membaca Word: ' + e.message + ']';
    }
  }

  async function aiCallWithFallback(messages) {
    // Panggil proxy server kita; server yang pegang API key + fallback antar-model.
    const res = await fetch(AI_PROXY_URL, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ messages })
    });

    let data;
    try {
      data = await res.json();
    } catch {
      throw new Error('Waduh, server lagi sibuk nih 😅 Coba lagi sebentar ya teman perencana!');
    }

    if (!res.ok || (data && data.error)) {
      const msg = (data && data.error && data.error.message) || 'Koneksi ke server terputus.';
      throw new Error(msg);
    }

    return data;
  }

  async function aiSendMessage() {
    const text = aiChatInput.value.trim();
    if (!text && !selectedFile) return;

    let displayHtml = '';
    if (selectedFileType === 'image' && selectedFileBase64) {
      displayHtml = `<img src="${selectedFileBase64}" class="rounded-xl mb-2 max-w-full" style="max-height:120px;object-fit:cover;">`;
    } else if (selectedFileText) {
      const icon = selectedFileType === 'pdf' ? '📄' : '📝';
      displayHtml = `<span class="block text-xs opacity-70 mb-1">${icon} ${selectedFile.name}</span>`;
    }
    if (text) displayHtml += text.replace(/\n/g, '<br>');

    aiAddMessage(displayHtml, true);

    let userMessageContent;

    if (selectedFileType === 'image' && selectedFileBase64) {
      userMessageContent = [
        { type: 'image_url', image_url: { url: selectedFileBase64 } },
        { type: 'text', text: text || 'Tolong analisis gambar ini ya!' }
      ];
    } else if (selectedFileText) {
      const fileInfo = `[File: ${selectedFile.name}]\n\nIsi dokumen:\n---\n${selectedFileText.substring(0, 6000)}\n---\n\n`;
      userMessageContent = fileInfo + (text || 'Tolong ringkas dan jelaskan isi dokumen ini ya!');
    } else {
      userMessageContent = text;
    }

    AI_HISTORY.push({ role: 'user', content: userMessageContent });

    aiChatInput.value = '';
    resetFile();
    aiFileInput.value = '';
    aiSendBtn.disabled = true;
    aiShowTyping();

    try {
      const data = await aiCallWithFallback(AI_HISTORY);
      aiHideTyping();
      const aiText = data.choices[0].message.content;
      AI_HISTORY.push({ role: 'assistant', content: aiText });
      aiAddMessage(aiText.replace(/\n/g, '<br>').replace(/\*\*(.*?)\*\*/g, '<b>$1</b>'));
    } catch (err) {
      aiHideTyping();
      aiAddMessage('😅 ' + (err.message || 'Koneksi terputus. Coba lagi ya bro!'));
    } finally {
      aiSendBtn.disabled = false;
      aiChatInput.focus();
    }
  }

  aiSendBtn.addEventListener('click', aiSendMessage);
  aiChatInput.addEventListener('keypress', (e) => {
    if (e.key === 'Enter' && !e.shiftKey) aiSendMessage();
  });
})();
</script>
