  function aiAddMessage(html, isUser = false, isFile = false) {
    const div = document.createElement('div');
    if (isUser) {
      div.className = 'self-end max-w-[85%] p-3.5 rounded-2xl rounded-tr-sm font-semibold text-sm break-words';
      div.style.background = 'var(--accent)';
