  // === Buka & Tutup Chat ===
  aiFab.addEventListener('click', () => {
    aiChatBox.classList.remove('hidden');
    setTimeout(() => {
      aiChatBox.classList.remove('opacity-0', 'translate-y-4', 'pointer-events-none');
      aiChatBox.classList.add('opacity-100', 'translate-y-0', 'flex');
      aiFab.classList.add('hidden');
      aiChatInput.focus();
    }, 10);
  });

  aiCloseBtn.addEventListener('click', () => {
    aiChatBox.classList.remove('opacity-100', 'translate-y-0');
    aiChatBox.classList.add('opacity-0', 'translate-y-4', 'pointer-events-none');
    setTimeout(() => {
      aiChatBox.classList.add('hidden');
      aiChatBox.classList.remove('flex');
      aiFab.classList.remove('hidden');
    }, 300);
  });

  // === Tambah Balon Chat ===
  function aiAddMessage(html, isUser = false, isFile = false) {
    const div = document.createElement('div');
    if (isUser) {
      div.className = 'self-end max-w-[85%] p-3.5 rounded-2xl rounded-tr-sm bg-primary text-on-primary font-semibold text-sm shadow-lg shadow-primary/20 break-words';
    } else {
      div.className = 'self-start max-w-[85%] p-3.5 rounded-2xl rounded-tl-sm bg-white/5 border border-white/10 text-sm text-white/90 leading-relaxed break-words';
    }
    div.innerHTML = html;
    aiChatBody.appendChild(div);
    aiChatBody.scrollTop = aiChatBody.scrollHeight;
    return div;
  }

  function aiShowTyping() {
    if (document.getElementById('ai-typing-indicator')) return;
    const div = document.createElement('div');
    div.id = 'ai-typing-indicator';
    div.className = 'self-start p-3.5 rounded-2xl rounded-tl-sm bg-white/5 border border-white/10 flex gap-1.5 items-center';
    div.innerHTML = `
      <div class="w-1.5 h-1.5 bg-primary/70 rounded-full animate-bounce" style="animation-delay:0ms"></div>
      <div class="w-1.5 h-1.5 bg-primary/70 rounded-full animate-bounce" style="animation-delay:150ms"></div>
      <div class="w-1.5 h-1.5 bg-primary/70 rounded-full animate-bounce" style="animation-delay:300ms"></div>
    `;
    aiChatBody.appendChild(div);
    aiChatBody.scrollTop = aiChatBody.scrollHeight;
  }

  function aiHideTyping() {
    const t = document.getElementById('ai-typing-indicator');
    if (t) t.remove();
  }

  // === File Upload Handler ===
  aiFileInput.addEventListener('change', async (e) => {
    const file = e.target.files[0];
    if (!file) return;
    resetFile();

    selectedFile = file;
    const name = file.name;
    const ext = name.split('.').pop().toLowerCase();

    aiFileName.textContent = name;
    aiFilePreview.classList.remove('hidden');
    aiFilePreview.classList.add('flex');

    if (['jpg','jpeg','png','gif','webp'].includes(ext)) {
      selectedFileType = 'image';
      // Konversi ke base64
      selectedFileBase64 = await fileToBase64(file);
    } else if (ext === 'pdf') {
      selectedFileType = 'pdf';
      aiFileName.textContent = '⏳ Membaca PDF... ' + name;
      selectedFileText = await extractPdfText(file);
      aiFileName.textContent = '📄 ' + name;
    } else if (['doc','docx'].includes(ext)) {
      selectedFileType = 'word';
      aiFileName.textContent = '⏳ Membaca Word... ' + name;
      selectedFileText = await extractWordText(file);
      aiFileName.textContent = '📝 ' + name;
    } else {
      aiFileName.textContent = '⚠️ Format tidak didukung';
      selectedFile = null;
    }
  });

  aiFileRemove.addEventListener('click', () => {
    resetFile();
    aiFileInput.value = '';
  });

  function resetFile() {
    selectedFile = null;
    selectedFileType = null;
    selectedFileBase64 = null;
    selectedFileText = null;
    aiFilePreview.classList.add('hidden');
    aiFilePreview.classList.remove('flex');
    aiFileName.textContent = '';
  }

  function fileToBase64(file) {
    return new Promise((resolve) => {
      const reader = new FileReader();
      reader.onload = (e) => resolve(e.target.result);
      reader.readAsDataURL(file);
    });
  }

  async function extractPdfText(file) {
    try {
      if (typeof pdfjsLib === 'undefined') return '[PDF.js belum siap]';
      pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
      const arrayBuffer = await file.arrayBuffer();
      const pdf = await pdfjsLib.getDocument({ data: arrayBuffer }).promise;
      let text = '';
      for (let i = 1; i <= Math.min(pdf.numPages, 10); i++) {
        const page = await pdf.getPage(i);
        const content = await page.getTextContent();
        text += content.items.map(s => s.str).join(' ') + '\n';
      }
      return text.trim() || '[PDF tidak bisa dibaca - mungkin berbentuk scan/gambar]';
    } catch (e) {
      return '[Gagal membaca PDF: ' + e.message + ']';
    }
  }

  async function extractWordText(file) {
    try {
      if (typeof mammoth === 'undefined') return '[Mammoth.js belum siap]';
      const arrayBuffer = await file.arrayBuffer();
      const result = await mammoth.extractRawText({ arrayBuffer });
      return result.value.trim() || '[Dokumen Word kosong atau tidak terbaca]';
    } catch (e) {
      return '[Gagal membaca Word: ' + e.message + ']';
    }
  }

  // === Auto-Fallback API Call (9 Lapis) ===
  async function aiCallWithFallback(messages, modelIndex = 0) {
    if (modelIndex >= AI_MODELS.length) {
      throw new Error('Waduh, semua AI lagi istirahat serentak nih 😅 Coba lagi dalam beberapa detik ya teman perencana!');
    }

    const model = AI_MODELS[modelIndex];

    try {
      const res = await fetch(AI_API_URL, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': 'Bearer ' + AI_API_KEY,
          'HTTP-Referer': window.location.origin,
          'X-Title': 'Gana AI - Portal Perencana'
        },
        body: JSON.stringify({ model, messages })
      });

      const data = await res.json();

      if (data.error) {
        const shouldFallback = res.status === 429 || res.status === 503 ||
          res.status === 404 || res.status === 502 ||
          (data.error.message && (
            data.error.message.includes('No endpoints') ||
            data.error.message.includes('unavailable') ||
            data.error.message.includes('overloaded') ||
            data.error.message.includes('not available')
          ));
        if (shouldFallback) return aiCallWithFallback(messages, modelIndex + 1);
        throw new Error(data.error.message);
      }

      return data;
    } catch (err) {
      if (!err.message.includes('Waduh')) return aiCallWithFallback(messages, modelIndex + 1);
      throw err;
    }
  }

  // === Kirim Pesan ===
  async function aiSendMessage() {
    const text = aiChatInput.value.trim();
    if (!text && !selectedFile) return;

    // Tampilkan pesan user
    let displayHtml = '';
    if (selectedFileType === 'image' && selectedFileBase64) {
      displayHtml = `<img src="${selectedFileBase64}" class="rounded-xl mb-2 max-w-full" style="max-height:120px;object-fit:cover;">`;
    } else if (selectedFileText) {
      const icon = selectedFileType === 'pdf' ? '📄' : '📝';
      displayHtml = `<span class="block text-xs opacity-70 mb-1">${icon} ${selectedFile.name}</span>`;
    }
    if (text) displayHtml += text.replace(/\n/g, '<br>');
    aiAddMessage(displayHtml, true);

    // Siapkan isi pesan untuk API
    let userMessageContent;

    if (selectedFileType === 'image' && selectedFileBase64) {
      // Kirim sebagai vision (gambar + teks)
      userMessageContent = [
        { type: 'image_url', image_url: { url: selectedFileBase64 } },
        { type: 'text', text: text || 'Tolong analisis gambar ini ya!' }
      ];
    } else if (selectedFileText) {
      // Kirim teks hasil ekstraksi + pertanyaan user
      const fileInfo = `[File: ${selectedFile.name}]\n\nIsi dokumen:\n---\n${selectedFileText.substring(0, 6000)}\n---\n\n`;
      userMessageContent = fileInfo + (text || 'Tolong ringkas dan jelaskan isi dokumen ini ya!');
    } else {
      userMessageContent = text;
    }

    // Tambah ke history
    AI_HISTORY.push({ role: 'user', content: userMessageContent });

    // Reset input
    aiChatInput.value = '';
    resetFile();
    aiFileInput.value = '';
    aiSendBtn.disabled = true;
    aiShowTyping();

    try {
      const data = await aiCallWithFallback(AI_HISTORY);
      aiHideTyping();
      const aiText = data.choices[0].message.content;
      AI_HISTORY.push({ role: 'assistant', content: aiText });
      aiAddMessage(aiText.replace(/\n/g, '<br>').replace(/\*\*(.*?)\*\*/g, '<b>$1</b>'));
    } catch (err) {
      aiHideTyping();
      aiAddMessage('😅 ' + (err.message || 'Koneksi terputus. Coba lagi ya bro!'));
    } finally {
      aiSendBtn.disabled = false;
      aiChatInput.focus();
    }
  }

  aiSendBtn.addEventListener('click', aiSendMessage);
  aiChatInput.addEventListener('keypress', (e) => {
    if (e.key === 'Enter' && !e.shiftKey) aiSendMessage();
  });
})();
</script>
